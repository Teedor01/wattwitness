# Copy to .env (never commit .env). TESTNET USE ONLY: use a throwaway key that holds no real funds.
# Load with:  node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/live.ts <command>
# (works the same in Windows cmd.exe)

# JSON-RPC endpoint of the network you deploy to. Verify it is live before use. Do not hardcode.
RPC_URL=
# Deployer / site-owner / resolver key (0x-prefixed, 32 bytes).
PRIVATE_KEY=

# Contract configuration (defaults shown)
QUORUM=2
MIN_COVERAGE_MILLI=800
# Seconds a claim must stay unchallenged before it can be finalised. Use a short value for demos.
CHALLENGE_WINDOW_SECONDS=300

# Optional: fund each ephemeral attester wallet with this much ETH for gas (default 0.003)
ATTESTER_FUNDING_ETH=0.003
